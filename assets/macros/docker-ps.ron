    steps: [
        SendInput(data: "docker ps --format 'table {{.Names}}\\t{{.Status}}\\t{{.Image}}'\n"),
        WaitForPattern(pattern: "$ ", timeout_ms: 10000),
    ],
    variables: [],
    target_protocol: None,
    author: Some("built-in"),
    hotkey: None,
)
